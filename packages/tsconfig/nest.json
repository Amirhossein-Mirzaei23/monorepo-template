{
  "$schema": "https://json.schemastore.org/tsconfig",
  "display": "@monorepo/nest",
  "extends": "./base.json",
  "compilerOptions": {
    "module": "commonjs",
    "moduleResolution": "node10",
    "target": "es2023",
    "lib": ["es2023"],
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "isolatedModules": true,
    "removeComments": true,
    "declarationMap": false,
    "sourceMap": true,
    "outDir": "./dist",
    "baseUrl": "./"
  },
  "exclude": ["node_modules", "dist", "**/__tests__", "**/*.spec.ts", "**/*.e2e-spec.ts"]
}
