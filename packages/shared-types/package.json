{
  "name": "@monorepo/shared-types",
  "version": "0.1.0",
  "private": true,
  "description": "API contract types + zod schemas, generated from the NestJS swagger schema (npm run gen:types)",
  "license": "MIT",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "gen": "node scripts/generate.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "jest",
    "test:cov": "jest --coverage"
  },
  "dependencies": {
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "eslint": "^10.10.0",
    "jest": "^30.5.1",
    "openapi-typescript": "^7.13.0",
    "ts-jest": "^29.4.12",
    "typescript": "^7.0.2"
  }
}
