{
  "name": "monorepo-template",
  "version": "0.1.0",
  "private": true,
  "description": "npm workspaces monorepo template: NestJS API + Next.js feature-based web app + shared packages",
  "license": "MIT",
  "engines": {
    "node": ">=20",
    "npm": ">=10"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"npm run dev -w @monorepo/api\" \"npm run dev -w @monorepo/web\"",
    "dev:api": "npm run dev -w @monorepo/api",
    "dev:web": "npm run dev -w @monorepo/web",
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:cov": "npm run test:cov --workspaces --if-present",
    "gen:types": "npm run gen:openapi -w @monorepo/api && npm run gen -w @monorepo/shared-types",
    "gen:module": "plop --plopfile scripts/plopfile.mjs module",
    "gen:feature": "plop --plopfile scripts/plopfile.mjs feature",
    "docker:up": "docker compose up -d postgres",
    "docker:down": "docker compose down -v",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@monorepo/eslint-config": "*",
    "concurrently": "^10.0.5",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "prettier": "^3.9.6"
  }
}
