# Copy to .env and adjust. .env is git-ignored — never commit real secrets.

# Public: baked into the client bundle at build time (used by lib/config.ts).
NEXT_PUBLIC_API_URL=http://localhost:3001

# Server-only: the NestJS URL used by the BFF route handlers (src/app/api/**).
# Falls back to NEXT_PUBLIC_API_URL when unset.
API_URL=http://localhost:3001

# Observability (optional)
OTEL_ENABLED=false
OTEL_SERVICE_NAME=monorepo-web
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
