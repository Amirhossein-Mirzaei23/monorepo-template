# Copy to .env and adjust. .env is git-ignored — never commit real secrets.
NODE_ENV=development

# Server
PORT=3001
# Comma-separated allowlist of browser origins allowed to call the API
CORS_ORIGINS=http://localhost:3000

# Database (matches docker-compose.yml at the repo root)
DATABASE_URL=postgresql://monorepo:monorepo@localhost:5432/monorepo?schema=public

# Auth — generate real secrets with `openssl rand -base64 48`
JWT_ACCESS_SECRET=change-me-access-secret-min-16-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-min-16-chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# Rate limiting (global, per-IP)
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=100

# Observability
OTEL_ENABLED=false
OTEL_SERVICE_NAME=monorepo-api
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# Optional: Sentry error tracking
SENTRY_DSN=

# SMS delivery (IranPayamak pattern API) — needed only when sending SMS.
# Pattern codes + line number come from the dongeto backend account.
SMS_API_KEY=
SMS_PATTERN_URL=https://api.iranpayamak.com/ws/v1/sms/pattern
SMS_LINE_NUMBER=3000505
SMS_PATTERN_CODE_WEB=tBitOjdepX
SMS_PATTERN_CODE_ANDROID=nbFUR03Kmw

# OTP login codes — "true"/"false" only; dev mode logs/returns a fixed code instead of
# sending SMS and the API refuses to boot if enabled with NODE_ENV=production.
OTP_DEV_MODE=false
# Code time-to-live in ms (default 2 minutes)
OTP_TTL_MS=120000
# Wrong-code attempts before a code is locked (default 5)
OTP_MAX_ATTEMPTS=5
# Per-phone send caps: max sends per hour (default 3) and per day (default 5)
OTP_SEND_HOURLY=3
OTP_SEND_DAILY=5

# Media storage (local-disk driver) — root dir for uploaded files (git-ignored) and the
# public base URL used to build media links (API serves GET /media/:key).
STORAGE_DIR=./storage
PUBLIC_MEDIA_BASE_URL=http://localhost:3001/media

# Upload limits — images: max 10 MB each, max 15 per lot; videos: max 50 MB / 60 s each,
# max 3 per lot.
MAX_IMAGE_MB=10
MAX_VIDEO_MB=50
MAX_LOT_IMAGES=15
MAX_LOT_VIDEOS=3
MAX_VIDEO_SECONDS=60
# MEDIA-002 per-user daily image-upload quota (default 200 uploads/day/user).
MAX_IMAGE_UPLOADS_PER_DAY=200

# WebSocket gateway (/ws) — comma-separated allowlist of handshake origins.
WS_ORIGINS=http://localhost:3000
