# Copy to .env and adjust. .env is git-ignored — never commit real secrets.
NODE_ENV=development

# Server
PORT=3001
# Comma-separated allowlist of browser origins allowed to call the API
CORS_ORIGINS=http://localhost:3000

# Database (matches docker-compose.yml at the repo root)
DATABASE_URL=postgresql://monorepo:monorepo@localhost:5432/monorepo?schema=public

# Auth — generate real secrets with `openssl rand -base64 48`
JWT_ACCESS_SECRET=change-me-access-secret-min-16-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-min-16-chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# Rate limiting (global, per-IP)
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=100

# Observability
OTEL_ENABLED=false
OTEL_SERVICE_NAME=monorepo-api
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# Optional: Sentry error tracking
SENTRY_DSN=

# SMS delivery (IranPayamak pattern API) — needed only when sending SMS.
# Pattern codes + line number come from the dongeto backend account.
SMS_API_KEY=
SMS_PATTERN_URL=https://api.iranpayamak.com/ws/v1/sms/pattern
SMS_LINE_NUMBER=3000505
SMS_PATTERN_CODE_WEB=tBitOjdepX
SMS_PATTERN_CODE_ANDROID=nbFUR03Kmw
