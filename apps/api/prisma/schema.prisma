// Prisma schema — single source of truth for the data layer.
// Migrations: `npm run prisma:migrate` (local) / `npm run prisma:deploy` (CI/CD).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  ADMIN
}

/// Account lifecycle (plan §3) — DELETED is the soft-delete state (AUTH-008).
enum UserStatus {
  ACTIVE
  SUSPENDED
  BLOCKED
  DELETED
}

/// Buyer/seller hats on one account — never mutually exclusive (plan §2.7).
enum AccountRole {
  BUYER
  SELLER
}

/// What an OTP code unlocks (plan §3).
enum OtpPurpose {
  LOGIN
  PHONE_CHANGE
}

model User {
  id            String         @id @default(cuid())
  /// Iranian mobile number, normalized and stored as `09xxxxxxxxx`.
  phone         String         @unique
  email         String?        @unique
  name          String
  /// Admin password login only — phone-OTP users have no password (plan §2.7).
  passwordHash  String?
  role          UserRole       @default(USER)
  status        UserStatus     @default(ACTIVE)
  accountRoles  AccountRole[]  @default([])
  deletedAt     DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  refreshTokens RefreshToken[]

  @@index([status])
}

/// Refresh-token rotation store: only sha256 hashes are persisted.
/// deviceLabel/userAgent/lastUsedAt feed session management (AUTH-006).
model RefreshToken {
  id          String    @id @default(cuid())
  tokenHash   String    @unique
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt   DateTime
  revokedAt   DateTime?
  deviceLabel String?
  userAgent   String?
  lastUsedAt  DateTime?
  createdAt   DateTime  @default(now())

  @@index([userId])
}

/// Two-level marketplace taxonomy (CAT-001, plan §3). Admin-managed data —
/// never hardcoded enums in the UI. Depth ≤ 2 (a category may only nest under
/// a top-level parent) is a SERVICE-level rule (CategoriesService), not a DB
/// constraint. Inactive rows stay resolvable by id for historical lots; they
/// are only hidden from the public tree.
model Category {
  id        String     @id @default(cuid())
  /// Persian display name — the primary label (RTL default).
  nameFa    String
  /// Optional Latin name for admin/tooling display; `slug` is the EN key.
  nameEn    String?
  /// Unique kebab-case EN slug (validated `^[a-z0-9]+(-[a-z0-9]+)*$`).
  slug      String     @unique
  parentId  String?
  /// onDelete: Restrict — deleting a parent with children must be an explicit
  /// two-step admin action (re-parent or delete children first, CAT-004);
  /// deactivation, not deletion, is the normal lifecycle for referenced
  /// categories (lots keep referencing them).
  parent    Category?  @relation("CategoryChildren", fields: [parentId], references: [id], onDelete: Restrict)
  children  Category[] @relation("CategoryChildren")
  sortOrder Int
  isActive  Boolean    @default(true)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@index([parentId, sortOrder])
}

/// Phone OTP codes — only sha256 hashes are persisted; rows are hard-deleted
/// once expired (prune job, plan §12). Issued/verified by OtpService (AUTH-002).
/// NOTE: the "one active OTP per phone+purpose" guarantee is a partial unique
/// index (WHERE "consumedAt" IS NULL) that Prisma cannot express — it lives in
/// the AUTH-001 migration SQL.
model OtpCode {
  id         String     @id @default(cuid())
  phone      String
  codeHash   String
  purpose    OtpPurpose
  expiresAt  DateTime
  consumedAt DateTime?
  attempts   Int        @default(0)
  lastSentAt DateTime
  createdAt  DateTime   @default(now())

  @@index([phone, createdAt])
}
