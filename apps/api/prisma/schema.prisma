// Prisma schema — single source of truth for the data layer.
// Migrations: `npm run prisma:migrate` (local) / `npm run prisma:deploy` (CI/CD).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  ADMIN
}

/// Account lifecycle (plan §3) — DELETED is the soft-delete state (AUTH-008).
enum UserStatus {
  ACTIVE
  SUSPENDED
  BLOCKED
  DELETED
}

/// Buyer/seller hats on one account — never mutually exclusive (plan §2.7).
enum AccountRole {
  BUYER
  SELLER
}

/// What an OTP code unlocks (plan §3).
enum OtpPurpose {
  LOGIN
  PHONE_CHANGE
}

/// Lot lifecycle (plan §3): DRAFT → PENDING_REVIEW → ACTIVE|REJECTED,
/// ACTIVE ⇄ PAUSED, terminal EXPIRED/SOLD/REMOVED. The transition table lives
/// in the service layer (LOT-003); Persian labels in lots.constants.ts.
enum LotStatus {
  DRAFT
  PENDING_REVIEW
  ACTIVE
  PAUSED
  REJECTED
  EXPIRED
  SOLD
  REMOVED
}

/// Merchandise grade as declared by the seller (fa labels: lots.constants.ts).
enum LotCondition {
  GRADE_A
  GRADE_B
  GRADE_C
  MIXED
  NEW
  USED
  DAMAGED
  NEAR_EXPIRY
}

/// Why the stock is being liquidated — the marketplace's core merchandising story.
enum LiquidationReason {
  EXCESS_PRODUCTION
  CANCELLED_ORDER
  EXPORT_RETURN
  SEASON_CLEARANCE
  OVERSTOCK
  FACTORY_CLOSURE
  PACKAGING_CHANGE
  NEAR_EXPIRY
  OTHER
}

/// Pricing mode. AUCTION is a documented future value — deliberately absent
/// from the MVP (plan §3).
enum PricingType {
  FIXED
  NEGOTIABLE
}

/// Unit of the offered quantity (fa labels: lots.constants.ts).
enum LotUnit {
  PIECE
  SET
  BOX
  KG
  PAIR
  OTHER
}

/// Kind of binary a MediaAsset holds (plan §3) — drives the per-kind upload
/// limits/quota (MEDIA-002/003): images ≤ 10 MB × 15/lot, videos ≤ 50 MB × 60 s × 3/lot.
enum MediaType {
  IMAGE
  VIDEO
}

/// Conversation lifecycle (plan §3). BLOCKED is set by CHT-009 (block/report);
/// REPORTED marks a conversation under an open report — the column exists from
/// CHT-001 per plan §3, no API path writes it yet.
enum ConversationStatus {
  ACTIVE
  BLOCKED
  REPORTED
}

/// Message kinds (plan §3). senderId is null exactly for SYSTEM rows (the
/// sender-null = system rule). ACTION is reserved for future structured
/// payloads (CHT-008 architecture note); IMAGE/VIDEO sends land in CHT-007.
enum MessageType {
  TEXT
  IMAGE
  VIDEO
  SYSTEM
  ACTION
}

/// Offer lifecycle (plan §3). PENDING is the only live state; every decision
/// (COUNTERED | ACCEPTED | REJECTED | CANCELLED | EXPIRED) is terminal — the
/// transition table lives in the offers module (OFR-001,
/// offers.constants.ts); fa labels in the same file.
enum OfferStatus {
  PENDING
  COUNTERED
  ACCEPTED
  REJECTED
  CANCELLED
  EXPIRED
}

model User {
  id            String         @id @default(cuid())
  /// Iranian mobile number, normalized and stored as `09xxxxxxxxx`.
  phone         String         @unique
  email         String?        @unique
  name          String
  /// Admin password login only — phone-OTP users have no password (plan §2.7).
  passwordHash  String?
  role          UserRole       @default(USER)
  status        UserStatus     @default(ACTIVE)
  accountRoles  AccountRole[]  @default([])
  /// Set once by the first PUT /profiles/onboarding and never reset afterwards
  /// (ONB-001) — re-onboarding updates the profile but keeps the original date.
  onboardingCompletedAt DateTime?
  deletedAt     DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  refreshTokens RefreshToken[]
  profile       Profile?
  /// Lots owned by this account (seller side of the data spine, plan §3).
  lots          Lot[]
  /// Uploaded media (MEDIA-001).
  mediaAssets   MediaAsset[]
  /// Conversations where this account is the buyer (CHT-001).
  buyerConversations  Conversation[] @relation("ConversationBuyer")
  /// Conversations where this account is the seller (CHT-001).
  sellerConversations Conversation[] @relation("ConversationSeller")
  /// Messages this account sent (null senderId = SYSTEM rows, never in here).
  sentMessages  Message[]
  /// Offers this account made as the buyer (OFR-001).
  buyerOffers   Offer[]   @relation("OfferBuyer")
  /// Offers on this account's lots as the seller (OFR-001).
  sellerOffers  Offer[]   @relation("OfferSeller")
  /// Deals where this account is the buyer (DEAL-001).
  buyerDeals    Deal[]    @relation("DealBuyer")
  /// Deals where this account is the seller (DEAL-001).
  sellerDeals   Deal[]    @relation("DealSeller")
  /// Deal lifecycle events this account acted in (null actorId = system rows,
  /// e.g. the future 7-day auto-complete job — DEAL-001).
  dealEvents    DealEvent[]

  @@index([status])
}

/// Refresh-token rotation store: only sha256 hashes are persisted.
/// deviceLabel/userAgent/lastUsedAt feed session management (AUTH-006).
model RefreshToken {
  id          String    @id @default(cuid())
  tokenHash   String    @unique
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt   DateTime
  revokedAt   DateTime?
  deviceLabel String?
  userAgent   String?
  lastUsedAt  DateTime?
  createdAt   DateTime  @default(now())

  @@index([userId])
}

/// Two-level marketplace taxonomy (CAT-001, plan §3). Admin-managed data —
/// never hardcoded enums in the UI. Depth ≤ 2 (a category may only nest under
/// a top-level parent) is a SERVICE-level rule (CategoriesService), not a DB
/// constraint. Inactive rows stay resolvable by id for historical lots; they
/// are only hidden from the public tree.
model Category {
  id        String     @id @default(cuid())
  /// Persian display name — the primary label (RTL default).
  nameFa    String
  /// Optional Latin name for admin/tooling display; `slug` is the EN key.
  nameEn    String?
  /// Unique kebab-case EN slug (validated `^[a-z0-9]+(-[a-z0-9]+)*$`).
  slug      String     @unique
  parentId  String?
  /// onDelete: Restrict — deleting a parent with children must be an explicit
  /// two-step admin action (re-parent or delete children first, CAT-004);
  /// deactivation, not deletion, is the normal lifecycle for referenced
  /// categories (lots keep referencing them).
  parent    Category?  @relation("CategoryChildren", fields: [parentId], references: [id], onDelete: Restrict)
  children  Category[] @relation("CategoryChildren")
  /// Back-relation for the explicit ProfileInterest join (ONB-001).
  interests ProfileInterest[]
  /// Lots classified under this category (LOT-001).
  lots            Lot[] @relation("LotCategory")
  /// Lots whose optional subcategory is this category.
  subCategoryLots Lot[] @relation("LotSubcategory")
  sortOrder Int
  isActive  Boolean    @default(true)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@index([parentId, sortOrder])
}

/// Phone OTP codes — only sha256 hashes are persisted; rows are hard-deleted
/// once expired (prune job, plan §12). Issued/verified by OtpService (AUTH-002).
/// NOTE: the "one active OTP per phone+purpose" guarantee is a partial unique
/// index (WHERE "consumedAt" IS NULL) that Prisma cannot express — it lives in
/// the AUTH-001 migration SQL.
model OtpCode {
  id         String     @id @default(cuid())
  phone      String
  codeHash   String
  purpose    OtpPurpose
  expiresAt  DateTime
  consumedAt DateTime?
  attempts   Int        @default(0)
  lastSentAt DateTime
  createdAt  DateTime   @default(now())

  @@index([phone, createdAt])
}

/// Business identity, 1–1 with User (ONB-001, plan §3). The "Business" entity is
/// deliberately folded into nullable seller fields here — one account, dual
/// buyer/seller hats. province/city store slugs from the static geo list
/// (`src/common/constants/iran-geo.ts`); isBuyer/isSeller mirror
/// User.accountRoles and are written only through the onboarding transaction.
/// sellerBusinessType is a plain String validated against the DTO allowlist
/// (not a DB enum) so the list can grow without migrations.
model Profile {
  id                 String            @id @default(cuid())
  userId             String            @unique
  user               User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  displayName        String
  businessName       String?
  /// Province slug from iran-geo.ts (EN key; Persian label resolved client-side).
  province           String?
  /// City slug from iran-geo.ts — always written together with its province.
  city               String?
  bio                String?
  instagram          String?
  website            String?
  isBuyer            Boolean           @default(false)
  isSeller           Boolean           @default(false)
  sellerYearsActive  Int?
  sellerBusinessType String?
  sellerDescription  String?
  interests          ProfileInterest[]
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
}

/// Explicit profile↔category interests join (ONB-001) — a real FK table, not a
/// Prisma implicit m–n, per the relational-spine rule. The interest set is
/// replaced wholesale inside the onboarding transaction.
model ProfileInterest {
  id         String   @id @default(cuid())
  profileId  String
  profile    Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([profileId, categoryId])
  @@index([categoryId])
}

/// The marketplace's central entity (LOT-001, plan §3). `code` is the public,
/// non-sequential URL id (8-char base62, `generateLotCode()` in
/// src/modules/lots/lots.constants.ts) so internal cuids stay private; code
/// collisions are retried at the service layer (LOT-002). province/city store
/// slugs from the static geo list, same convention as Profile. exactAddress /
/// rejectionReason are PRIVATE — only ever exposed in the owner response shape
/// (LOT-002 DTOs), never in public payloads.
/// Money/quantities are positive Toman Ints; unitPrice = round(totalPrice /
/// quantity) is derived at the service layer on write (plan §12) and stored so
/// the public list can filter/sort on it with plain b-tree indexes.
model Lot {
  id                String            @id @default(cuid())
  code              String            @unique
  sellerId          String
  /// onDelete: Restrict — users are soft-deleted (plan §12); a hard delete
  /// behind live lots must be impossible.
  seller            User              @relation(fields: [sellerId], references: [id], onDelete: Restrict)
  categoryId        String
  /// Deactivation, not deletion, is the lifecycle for referenced categories
  /// (CAT-001) — lots keep pointing at inactive rows.
  category          Category          @relation("LotCategory", fields: [categoryId], references: [id], onDelete: Restrict)
  /// Optional child category; must be a child of `category` — service rule (LOT-002).
  subcategoryId     String?
  subcategory       Category?         @relation("LotSubcategory", fields: [subcategoryId], references: [id], onDelete: Restrict)
  title             String
  description       String
  quantity          Int
  /// Defaults to PIECE (LOT-002 validation); minOrder ≤ quantity and
  /// 0 ≤ availableQuantity ≤ quantity are service-layer invariants, not DB
  /// constraints (plan §12).
  unit              LotUnit           @default(PIECE)
  availableQuantity Int
  minOrderQuantity  Int
  pricingType       PricingType
  /// Toman integer, ≤ 2,000,000,000 (validated in LOT-002 DTOs).
  totalPrice        Int
  /// Stored, derived on write: round(totalPrice / quantity).
  unitPrice         Int
  condition         LotCondition
  liquidationReason LiquidationReason
  province          String
  city              String
  /// Approximate public area hint (free text ≤ 100 chars) — never the address.
  locationHint      String?
  /// PRIVATE — published only after a deal, owner shape only (plan §3).
  exactAddress      String?
  status            LotStatus         @default(DRAFT)
  /// Moderation verdict — owner-only visibility (LOT-002 response split).
  rejectionReason   String?
  /// Atomic-increment counters via updateMany — no read-modify-write (plan §12).
  viewCount         Int               @default(0)
  saveCount         Int               @default(0)
  /// Listing expiry. The hourly sweep (LOT-006) flips past-due ACTIVE rows to
  /// EXPIRED; findPublic applies expiresAt > now as a safety filter so stale
  /// rows never show between sweeps.
  expiresAt         DateTime
  publishedAt       DateTime?
  soldAt            DateTime?
  featuredAt        DateTime?
  /// Soft delete (plan §12): DELETE (LOT-003) sets status REMOVED + this stamp.
  deletedAt         DateTime?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  @@index([status, createdAt])
  @@index([status, expiresAt])
  @@index([categoryId, status])
  @@index([city, status])
  @@index([sellerId, status])
  /// Trigram search indexes (LOT-001, plan §12) — created with pg_trgm in the
  /// migration; declared here with matching names so migrate diff sees no drift.
  @@index([title(ops: raw("gin_trgm_ops"))], type: Gin, map: "Lot_title_trgm_idx")
  @@index([description(ops: raw("gin_trgm_ops"))], type: Gin, map: "Lot_description_trgm_idx")

  /// Ordered gallery (MEDIA-005) — the join table IS the gallery: order and
  /// cover live here, not on the asset or the client.
  media LotMedia[]
  /// Buyer threads opened on this lot — at most one per buyer
  /// (unique(lotId, buyerId), CHT-001).
  conversations Conversation[]
  /// Negotiation offers on this lot (OFR-001).
  offers        Offer[]
  /// Transactions on this lot (DEAL-001).
  deals         Deal[]
}

/// An uploaded binary and its storage metadata (MEDIA-001, plan §3). The bytes
/// live behind a StorageService driver (local disk now, S3-compatible later —
/// MEDIA-006); only keys/metadata are relational. `storageKey` is the
/// driver-relative path `{yyyy}/{mm}/{cuid}.{ext}` (unguessable: random id +
/// no filename reuse) and is UNIQUE so serving is an O(1) lookup by key.
/// Content-type/size are read back from THIS row at serving time — never from
/// the request. width/height/durationMs are set by the upload pipeline
/// (MEDIA-002/003); thumbKey is the WebP thumbnail variant key (MEDIA-002).
model MediaAsset {
  id         String    @id @default(cuid())
  ownerId    String
  /// onDelete: Restrict — users are soft-deleted (plan §12); mirrors
  /// Lot.seller: a hard user delete behind live assets must be impossible.
  owner      User      @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  type       MediaType
  /// Driver-relative storage key; `secure/`-prefixed keys are chat media
  /// served only behind JWT (GET /media/secure/:key), the rest are public.
  storageKey String    @unique
  /// Optional thumbnail variant key (MEDIA-002 sharp pipeline).
  thumbKey   String?
  mime       String
  sizeBytes  Int
  width      Int?
  height     Int?
  durationMs Int?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  /// (ownerId, createdAt) per plan §3 — quota counting (MEDIA-002) is
  /// "rows for owner in window", which this composite also covers.
  @@index([ownerId, createdAt])

  /// Lots currently displaying this asset (MEDIA-005) — assets are shared
  /// content (a future message/avatar may reference them too), so linking,
  /// not owning, is the relationship.
  lotMedia LotMedia[]
  /// Chat messages carrying this asset (IMAGE/VIDEO, CHT-007).
  messages Message[]
}

/// Ordered lot↔media link (MEDIA-005, plan §3). A real join table (not an
/// implicit m–n) because sortOrder/isCover are DATA, not client state.
/// Galleries are replaced transactionally by LotsService.putMedia: kept rows
/// are updated in place (id/createdAt preserved), removed links deleted.
model LotMedia {
  id           String   @id @default(cuid())
  lotId        String
  /// onDelete: Cascade — a HARD-deleted lot takes its links with it. Lots are
  /// soft-deleted in practice (REMOVED + deletedAt, LOT-003), so this only
  /// fires on explicit row cleanup; picked over Restrict for cleanliness so
  /// no orphaned link can outlive its lot row.
  lot          Lot      @relation(fields: [lotId], references: [id], onDelete: Cascade)
  mediaAssetId String
  /// onDelete: Restrict — an asset displayed by any gallery must not be
  /// hard-deleted behind it; unlinking happens only through the lot's own
  /// PUT /lots/:id/media replace. Physical file cleanup of unlinked assets is
  /// a deferred P1 job (MEDIA-005 card — "orphan cleanup").
  mediaAsset   MediaAsset @relation(fields: [mediaAssetId], references: [id], onDelete: Restrict)
  /// 0-based display position within the lot gallery (gaps allowed; reads are
  /// always orderBy sortOrder asc — served by the (lotId, sortOrder) index).
  sortOrder    Int
  /// Cover flag — EXACTLY ONE per lot is a service invariant (coverIndex on
  /// the replace payload), not a DB constraint.
  isCover      Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  /// One link per (lot, asset) pair; (lotId, sortOrder) serves ordered reads.
  @@unique([lotId, mediaAssetId])
  @@index([lotId, sortOrder])
}

/// One buyer↔seller negotiation thread about ONE lot (CHT-001, plan §3) —
/// the product's "one thread per buyer per lot" rule is the DB-level
/// unique(lotId, buyerId); the seller is DERIVED from the lot (denormalized
/// onto the row only so participant queries are a plain indexed lookup).
/// lastMessageAt/lastMessagePreview are denormalized list-feed data (CHT-002
/// renders the inbox from them without joining Message); the unread counters
/// are per-side and bumped atomically by the CHT-003 send/read endpoints
/// (updateMany increments — never read-modify-write, plan §12).
model Conversation {
  id                 String             @id @default(cuid())
  lotId              String
  /// onDelete: Cascade — a HARD-deleted lot takes its threads with it. Lots
  /// are soft-deleted in practice (REMOVED + deletedAt, LOT-003), mirroring
  /// LotMedia.lot: this fires only on explicit row cleanup.
  lot                Lot                @relation(fields: [lotId], references: [id], onDelete: Cascade)
  buyerId            String
  /// onDelete: Restrict on both participants — users are soft-deleted
  /// (plan §12); a hard user delete behind live conversations must be
  /// impossible (same reasoning as Lot.seller).
  buyer              User               @relation("ConversationBuyer", fields: [buyerId], references: [id], onDelete: Restrict)
  /// Copied from Lot.sellerId at create (the service derives it — never the
  /// client); kept on the row to serve seller-inbox queries by index.
  sellerId           String
  seller             User               @relation("ConversationSeller", fields: [sellerId], references: [id], onDelete: Restrict)
  status             ConversationStatus @default(ACTIVE)
  /// Stamp of the newest message (welcome message included) — the inbox sort
  /// key; every message write moves it forward (CHT-003).
  lastMessageAt      DateTime
  /// Truncated preview of the newest message body (CHT-002, ≤ 80 chars).
  lastMessagePreview String?
  /// Per-side unread counters, atomic {increment} writes only (CHT-003).
  buyerUnreadCount   Int                @default(0)
  sellerUnreadCount  Int                @default(0)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  messages Message[]

  /// Offers optionally tied to this thread (OFR-001) — SetNull on thread
  /// deletion, offers outlive conversations (see the Offer model doc).
  offers Offer[]

  /// Deals optionally tied to this thread (DEAL-001) — SetNull, the same
  /// outlives-the-thread decision as offers.
  deals Deal[]

  /// The product's one-thread-per-buyer-per-lot rule (CHT-001).
  @@unique([lotId, buyerId])
  /// Participant inbox feeds (CHT-002): newest-activity first per side.
  @@index([buyerId, lastMessageAt])
  @@index([sellerId, lastMessageAt])
}

/// A single chat message (CHT-001 schema, plan §3). Append-only: rows are
/// never updated in place — the only mutable field is readAt (CHT-003 batch
/// read-marking), so there is no updatedAt. body is a Postgres TEXT column
/// (Prisma String default) — the ≤ 2000-char cap is the CHT-003 DTO's job.
model Message {
  id             String      @id @default(cuid())
  conversationId String
  /// onDelete: Cascade — a hard-deleted conversation takes its messages with
  /// it (same cleanup-only firing as Conversation.lot).
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  /// null exactly for SYSTEM rows (the welcome message, CHT-001).
  senderId       String?
  /// onDelete: Restrict — soft-deleted users must stay resolvable as the
  /// author of history (same rule as Conversation participants).
  sender         User?       @relation(fields: [senderId], references: [id], onDelete: Restrict)
  type           MessageType @default(TEXT)
  /// Text payload (TEXT) or the fa system copy (SYSTEM); null for media rows.
  body           String?
  mediaAssetId   String?
  /// onDelete: Restrict — an asset referenced by chat history must not be
  /// hard-deleted behind it (CHT-007 secure serving resolves access THROUGH
  /// this row); mirrors LotMedia.mediaAsset.
  mediaAsset     MediaAsset? @relation(fields: [mediaAssetId], references: [id], onDelete: Restrict)
  /// Optional parent message (reply UI, CHT-006 — model-ready from CHT-001).
  replyToId      String?
  /// onDelete: Cascade — a reply is meaningless without its target.
  replyTo        Message?    @relation("MessageReplies", fields: [replyToId], references: [id], onDelete: Cascade)
  replies        Message[]   @relation("MessageReplies")
  /// Set by the CHT-003 read endpoint (batch where readAt null); null = unread.
  readAt         DateTime?
  createdAt      DateTime    @default(now())

  /// Thread history reads (CHT-003 cursor pagination walks this index).
  @@index([conversationId, createdAt])
}

/// A buyer's price/quantity proposal on a lot (OFR-001, plan §3) — the
/// negotiation atom. Counter-offers create a NEW row linked through `parentId`
/// while the countered row flips to COUNTERED, so every row is immutable
/// negotiation history: the status only ever moves forward from PENDING (the
/// transition table + fa labels live in offers.constants.ts, OFR-001).
/// sellerId is copied from the lot at create (denormalized exactly like
/// Conversation.sellerId — the (sellerId, status) plan index serves the
/// seller's action inbox without a join; the service derives it, never the
/// client). Money is positive Toman Int (plan §12): `unitPrice` is the
/// negotiated per-unit price (1..2B, the input the buyer controls) and
/// `totalPrice` is DERIVED on write = unitPrice × quantity — the same
/// derive-on-write convention as Lot, mirrored (lots negotiate the total and
/// derive the unit price; offers negotiate the unit price and derive the
/// total). `decidedAt` is stamped by every legal transition (all leave
/// PENDING); `expiresAt` defaults to +72h (OFFER_EXPIRY_DAYS = 3) and the
/// OFR-003 sweep flips past-due PENDING rows to EXPIRED.
model Offer {
  id             String      @id @default(cuid())
  lotId          String
  /// onDelete: Cascade — mirrors Conversation.lot: lots are soft-deleted in
  /// practice (REMOVED + deletedAt, LOT-003), so this fires only on explicit
  /// row cleanup.
  lot            Lot         @relation(fields: [lotId], references: [id], onDelete: Cascade)
  buyerId        String
  /// onDelete: Restrict — users are soft-deleted (plan §12); offers must stay
  /// resolvable as a buyer's negotiation history (same rule as Conversation
  /// participants).
  buyer          User        @relation("OfferBuyer", fields: [buyerId], references: [id], onDelete: Restrict)
  /// Copied from Lot.sellerId at create — the service derives it, never the
  /// client; onDelete: Restrict for the same soft-delete reason as buyer.
  sellerId       String
  seller         User        @relation("OfferSeller", fields: [sellerId], references: [id], onDelete: Restrict)
  /// Optional negotiation thread the offer was made in. onDelete: SetNull —
  /// DOCUMENTED DECISION: an offer is a binding commercial record that may
  /// outlive its thread (conversations can be blocked/removed, CHT-009);
  /// losing the link must neither delete the offer nor corrupt its chain, so
  /// the link simply nulls out.
  conversationId String?
  conversation   Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  /// Counter chain: the offer THIS row counters (null = a fresh root offer).
  /// onDelete: Cascade — DOCUMENTED DECISION: a counter offer is meaningless
  /// without the offer it answers; SetNull would rewrite history by turning
  /// counters into fake root offers. Cleanup removes the whole descendant
  /// chain instead. Only ever fires on explicit row cleanup — no API deletes
  /// offers (statuses are the lifecycle).
  parentId       String?
  parent         Offer?      @relation("OfferCounterChain", fields: [parentId], references: [id], onDelete: Cascade)
  /// The counters this offer received (the chain's forward links).
  children       Offer[]     @relation("OfferCounterChain")
  /// Deals grown out of this offer once accepted (DEAL-001/002) — the deal
  /// side is SetNull: the deal outlives the offer (see the Deal model doc).
  deals          Deal[]
  /// Offered piece count — must be within lot.minOrderQuantity..lot
  /// .availableQuantity AT OFFER TIME (validated on write; OFR-002 re-checks
  /// availability at accept).
  quantity       Int
  /// Negotiated per-unit Toman, 1..2,000,000,000 (offers.constants bounds).
  unitPrice      Int
  /// Derived on write: unitPrice × quantity (never client-supplied).
  totalPrice     Int
  /// Optional free-text note from the buyer, ≤ 500 chars (offers.constants).
  note           String?
  status         OfferStatus @default(PENDING)
  /// Expiry deadline (default +72h). Acceptance must happen before it
  /// (OFR-002); the OFR-003 hourly sweep stamps EXPIRED past due.
  expiresAt      DateTime
  /// Decision stamp — set by every legal transition (they all leave PENDING).
  decidedAt      DateTime?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  /// Buyer's offer history per lot (plan §3).
  @@index([lotId, buyerId, createdAt])
  /// Seller action inbox (plan §3).
  @@index([sellerId, status])
  /// Expiry sweep + "live offers" reads (plan §3) — serves the OFR-003 batch.
  @@index([status, expiresAt])
}

/// Deal lifecycle (plan §3) — the transaction spine. NEGOTIATING is the only
/// creation state; AGREED..DELIVERED are the live fulfilment stages; terminal
/// states are COMPLETED | CANCELLED | DISPUTED (DISPUTED is "terminal pending
/// admin resolution" — only ADMIN moves out of it, endpoints are DEAL-007 P1).
/// The transition table + role permissions live in the deals module
/// (DEAL-001, deals.constants.ts); fa labels in the same file.
enum DealStatus {
  NEGOTIATING
  AGREED
  PAYMENT_PENDING
  PAID
  PREPARING
  SHIPPED
  DELIVERED
  COMPLETED
  CANCELLED
  DISPUTED
}

/// How the goods change hands (plan §3). Recorded, not processed — the MVP
/// has no shipment integration (folded Shipment entity, plan §3).
enum DeliveryMethod {
  PICKUP
  SELLER_SHIPS
  BUYER_TRANSPORT
  CARRIER
}

/// How payment happened — RECORDED ONLY (plan §3, decision D9): no gateway,
/// no wallet, no escrow in MVP; the enum documents the agreed method both
/// sides see (DEAL-006).
enum PaymentMethodRecorded {
  CASH
  CARD_TO_CARD
  BANK_TRANSFER
  CHEQUE
}

/// The transaction between one buyer and one seller over ONE lot (DEAL-001,
/// plan §3) — the immutable-terms record: quantity and prices are SNAPSHOT
/// copies (quantity validated `≤ lot.availableQuantity` at creation; later
/// lot edits never mutate an existing deal). offerId/conversationId are
/// optional provenance links (a deal is struck from an accepted offer OR
/// directly in chat — DEAL-002), both SetNull: the deal is the binding
/// commercial record and outlives its negotiation context (mirrors the
/// Offer↔Conversation decisions). Payment is recorded, not processed (D9):
/// `paidConfirmedByBuyerAt` is the buyer's «پرداخت کردم» mark (a timeline
/// event + this stamp — NOT a status change; only the SELLER's confirm moves
/// PAYMENT_PENDING → PAID, DEAL-001 matrix).
/// commissionRate is RESERVED (0 MVP): basis points (percent × 100, so 250 =
/// 2.5%) — Int keeps the money math integer-safe; commissionAmount (the
/// derived Toman take) stays null until commission lands (DEAL-006).
model Deal {
  id         String     @id @default(cuid())
  /// Public, non-sequential URL id — 8-char base62 (`generateDealCode()`,
  /// deals.constants.ts), same scheme as Lot.code; collisions are retried at
  /// the service layer (DEAL-002).
  code       String     @unique
  lotId      String
  /// onDelete: Cascade — mirrors Offer.lot: lots are soft-deleted in practice
  /// (REMOVED + deletedAt, LOT-003), so this fires only on explicit row
  /// cleanup.
  lot        Lot        @relation(fields: [lotId], references: [id], onDelete: Cascade)
  buyerId    String
  /// onDelete: Restrict — users are soft-deleted (plan §12); the transaction
  /// history must stay resolvable for BOTH participants (auditability,
  /// principles 12/13).
  buyer      User       @relation("DealBuyer", fields: [buyerId], references: [id], onDelete: Restrict)
  /// Copied from Lot.sellerId at create — the service derives it, never the
  /// client (same denormalization as Conversation/Offer); onDelete: Restrict.
  sellerId   String
  seller     User       @relation("DealSeller", fields: [sellerId], references: [id], onDelete: Restrict)
  /// The accepted offer this deal grew out of, when one exists (DEAL-002's
  /// offer path). onDelete: SetNull — DOCUMENTED DECISION, mirrors
  /// Offer.conversationId: the deal outlives its offer row.
  offerId    String?
  offer      Offer?     @relation(fields: [offerId], references: [id], onDelete: SetNull)
  /// The thread the deal was struck in (DEAL-002's chat quick path).
  /// onDelete: SetNull — the same outlives-the-thread decision as offers.
  conversationId String?
  conversation   Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)

  // --- terms snapshot (immutable after create — renegotiation is a new deal) ---
  /// Dealt piece count — ≤ lot.availableQuantity AT CREATION (validated on
  /// write; the reservation itself is DEAL-002's transactional decrement).
  quantity       Int
  /// Agreed per-unit Toman, 1..2,000,000,000 (the same money bounds as offers).
  unitPrice      Int
  /// Derived on write: unitPrice × quantity (never client-supplied).
  totalPrice     Int
  deliveryMethod DeliveryMethod
  /// Optional free-text delivery arrangement, ≤ 500 chars (deals.constants).
  deliveryNote   String?
  paymentMethod  PaymentMethodRecorded
  /// Optional free-text payment terms, ≤ 500 chars (deals.constants).
  paymentTermsNote String?
  /// The buyer's «پرداخت کردم» mark (DEAL-006 endpoint) — informational, NOT
  /// a status change: only the seller's confirm performs PAYMENT_PENDING →
  /// PAID (the DEAL-001 matrix).
  paidConfirmedByBuyerAt DateTime?
  /// Reserved commission rate in basis points (percent × 100; 250 = 2.5%) —
  /// 0 MVP, configurable const in deals.constants (DEAL-006 populates).
  commissionRate     Int     @default(0)
  /// Derived Toman take = totalPrice × rate / 10000 — null until commission
  /// lands (DEAL-006); nullable keeps "not computed" distinct from 0.
  commissionAmount   Int?

  status        DealStatus @default(NEGOTIATING)
  /// Why the deal was cancelled — required by every →CANCELLED move
  /// (deals.constants requiresReason); visible to both parties.
  cancelReason  String?
  /// Why the deal is disputed — required by every →DISPUTED move; the
  /// ≥ 20-char rule is DEAL-003's API-level validation.
  disputeReason String?

  // --- stage stamps: set exactly when the machine ENTERS that stage ---
  /// (the creation state NEGOTIATING is covered by createdAt)
  agreedAt         DateTime?
  paymentPendingAt DateTime?
  paidAt           DateTime?
  preparingAt      DateTime?
  shippedAt        DateTime?
  deliveredAt      DateTime?
  completedAt      DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  /// The audit timeline (every transition appends one — DEAL-001).
  events DealEvent[]

  /// Buyer deal history (plan §3).
  @@index([buyerId, updatedAt])
  /// Seller deal history (plan §3).
  @@index([sellerId, updatedAt])
  /// Status-filtered lists (plan §3).
  @@index([status])
}

/// Append-only lifecycle entry for a Deal (DEAL-001, plan §3) — the
/// auditability half of the spine (principle 13). Every legal transition
/// appends one row in the SAME transaction as the status write; actorId is
/// null for system events (the future 7-day auto-complete job). Creation
/// itself appends the first event (fromStatus = toStatus = NEGOTIATING), so
/// the timeline is total; rows are never updated or deleted.
model DealEvent {
  id         String     @id @default(cuid())
  dealId     String
  /// onDelete: Cascade — an event is meaningless without its deal (mirrors
  /// Message.conversation; fires only on explicit row cleanup).
  deal       Deal       @relation(fields: [dealId], references: [id], onDelete: Cascade)
  /// The acting party — null = system (the auto-complete job; DEAL-007's
  /// admin resolutions act as the admin User). onDelete: Restrict —
  /// soft-deleted users stay resolvable as history authors (Message.sender
  /// precedent).
  actorId    String?
  actor      User?      @relation(fields: [actorId], references: [id], onDelete: Restrict)
  /// Status before the move (== toStatus for informational/creation events).
  fromStatus DealStatus
  /// Status after the move.
  toStatus   DealStatus
  /// Optional note — the cancel/dispute REASON lands here too (as well as in
  /// the deal's cancelReason/disputeReason column); fa copy is written by the
  /// callers (deals.constants owns the templates, DEAL-006).
  note       String?
  createdAt  DateTime   @default(now())

  /// Timeline reads for one deal (plan §3) — oldest first.
  @@index([dealId, createdAt])
}
